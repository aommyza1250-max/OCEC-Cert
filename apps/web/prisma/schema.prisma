// ฐานข้อมูลระบบเกียรติบัตร OCEC
// เอกสารประกอบ: docs/db-schema.md
//
// หลักการ: staging_pages เก็บผลการตัดหน้า PDF ไว้ก่อน แล้วค่อย match กับ Excel ทีหลัง
// ทำให้ re-run การ match ได้โดยไม่ต้องตัด PDF ใหม่ และมีที่ให้แอดมินจับคู่ด้วยมือ

generator client {
  provider        = "prisma-client-js"
  // ต้องเปิดเพื่อประกาศ extension และ GIN index พร้อม operator class ในไฟล์นี้ได้
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm ใช้ทำ trigram index สำหรับค้นหาชื่อบางส่วน — ประกาศไว้ที่นี่เพื่อให้
  // migrate สร้างให้เองทุกครั้ง ไม่ต้องไปเขียน SQL แยกซึ่งจะถูก migrate รอบถัดไปลบทิ้ง
  extensions = [pg_trgm]
}

/// รอบการสอบ — กำหนดว่าต้องกรองสัญชาติหรือไม่
/// HEAT  (รอบคัดเลือก) ผู้เข้าสอบเป็นคนไทยทั้งหมด ตัดแยกทุกหน้า
/// FINAL (รอบชิงชนะเลิศ) ไฟล์รวมทุกประเทศ ต้องกรองเฉพาะ "from THAILAND"
/// บันทึกว่าเคยมีรอบนำเข้านี้อยู่และถูกลบไปเมื่อไหร่
/// จำเป็นเพราะแถว batches หายไปพร้อมการลบ ถ้าไม่บันทึกจะไม่เหลือร่องรอยว่าเคยมีอะไร
model DeletedBatch {
  id          String    @id @default(uuid()) @db.Uuid
  programCode String    @map("program_code")
  round       ExamRound
  year        Int

  certificateCount Int  @map("certificate_count")
  studentCount     Int  @map("student_count")
  fileCount        Int  @map("file_count")
  bytesFreed       BigInt @map("bytes_freed")

  note      String?
  deletedAt DateTime @default(now()) @map("deleted_at")

  @@index([deletedAt])
  @@map("deleted_batches")
}

enum ExamRound {
  HEAT
  FINAL
}

enum BatchStatus {
  DRAFT        // สร้างแล้วแต่ยังไม่อัปโหลด ZIP
  SPLITTING    // worker กำลังตัดหน้า
  SPLIT_DONE   // ตัดเสร็จ รอ Excel
  MATCHING     // worker กำลังจับคู่กับ Excel
  READY        // จับคู่เสร็จ รอแอดมินตรวจ/publish
  PUBLISHED    // ผู้ใช้ทั่วไปค้นเจอแล้ว
  FAILED       // job พัง ดูรายละเอียดที่ Job.error
  DELETING     // กำลังลบทั้งรอบ — กันไม่ให้มีใครไปกดอย่างอื่นกับรอบที่กำลังหายไป
}

enum MatchStatus {
  UNMATCHED       // ตัดหน้าได้แล้วแต่ยังไม่มีคู่ใน Excel
  MATCHED         // จับคู่แล้ว มี Certificate ออกมา
  SKIPPED_FOREIGN // หน้าของผู้เข้าสอบต่างชาติ (batch international) — ข้ามตั้งแต่ต้น
  AMBIGUOUS       // ชื่อตรงกับหน้าใน PDF มากกว่า 1 หน้า ต้องให้คนตัดสิน
  DUPLICATE_NAME  // ชื่อซ้ำกับหน้าที่จับคู่ไปแล้วในรายการสอบเดียวกัน — แอดมินต้องดูใบจริงแล้วตัดสิน
  DISCARDED       // แอดมินตัดสินแล้วว่าเป็นใบซ้ำ ไม่ต้องนำเข้า
}

/// ฮ่องกงส่งเกียรติบัตรฉบับจริงให้แบบไหนในรอบนั้น
/// Perfect Score เป็นรางวัลเสริมที่ให้คนได้เหรียญทองที่ทำคะแนนได้ดี
/// บางรอบส่งฉบับจริงมาทั้งสองใบ บางรอบส่งมาแค่ใบเหรียญ
enum MultiAwardPolicy {
  UNDECIDED  // ยังไม่ได้เลือก — เผยแพร่ไม่ได้จนกว่าจะเลือก (ถ้ารอบนั้นมีคนได้ Perfect Score)
  ALL        // เผยแพร่ทุกใบ
  MEDAL_ONLY // เผยแพร่เฉพาะใบเหรียญ ซ่อนใบ Perfect Score ของคนที่มีทั้งสองใบ
}

enum JobType {
  SPLIT
  MATCH
  /// ลบทั้งรอบนำเข้า ทั้งไฟล์บน R2 และแถวในฐานข้อมูล
  DELETE_BATCH
  /// ลบไฟล์ต้นฉบับ (ZIP และ PDF ที่อัปทีละใบ) หลังจับคู่ครบและเผยแพร่แล้ว
  CLEANUP_SOURCES
  /// กวาดเกียรติบัตรที่ครบอายุการเก็บแล้ว — เป็นงานของทั้งระบบ ไม่ผูกกับรอบนำเข้าใด
  EXPIRE
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// รายการสอบที่หน่วยงานจัด เช่น HKIMO, TIMO — แอดมินจัดการรายการนี้เองได้
/// `code` คือส่วนหนึ่งของชื่อไฟล์: {FNAME}_{LNAME}_{CODE}_{ROUND}_{AWARD}_{YEAR}.pdf
/// รายการสอบเดียวจัดได้ทั้งรอบ HEAT และ FINAL จึงไม่เก็บรอบไว้ที่นี่
model ExamProgram {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique
  name String
  /// ปิดรายการที่เลิกจัดแล้ว โดยไม่ต้องลบ (ลบไม่ได้ถ้ามีข้อมูลเก่าอ้างอยู่)
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exams Exam[]

  @@map("exam_programs")
}

/// รายการสอบ 1 รอบ ใน 1 ปี เช่น HKIMO รอบ FINAL ปี 2026
/// `year` เป็น **ค.ศ.** ตามที่พิมพ์อยู่บนหน้าเกียรติบัตร ไม่ใช่ พ.ศ.
model Exam {
  id        String      @id @default(uuid()) @db.Uuid
  programId String      @map("program_id") @db.Uuid
  program   ExamProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  round     ExamRound
  year      Int
  createdAt DateTime    @default(now()) @map("created_at")

  batches      Batch[]
  certificates Certificate[]

  @@unique([programId, round, year])
  @@index([year])
  @@map("exams")
}

/// ผู้เข้าสอบ 1 คน — ใช้ซ้ำข้ามรายการสอบและข้ามปี
model Student {
  id String @id @default(uuid()) @db.Uuid

  nameTh String? @map("name_th")
  nameEn String? @map("name_en")

  // ผลจาก normalizeName() — ใช้ค้นหาและจับคู่ ห้ามเขียนค่าดิบลงคอลัมน์นี้
  nameThNormalized String? @map("name_th_normalized")
  nameEnNormalized String? @map("name_en_normalized")
  // ผลจาก nameSortKey() — ตัวช่วยลำดับรองกรณี Excel สลับชื่อ-นามสกุล
  nameEnSortKey String? @map("name_en_sort_key")

  /// โรงเรียน — ใช้แยกคนที่ชื่อพ้องกันออกจากกัน (ชื่ออย่างเดียวไม่พอ)
  school String?
  /// ผลจาก normalizeSchool() — ใช้เทียบ ห้ามเขียนค่าดิบลงคอลัมน์นี้
  schoolNormalized String? @map("school_normalized")

  createdAt DateTime @default(now()) @map("created_at")

  certificates  Certificate[]
  stagingPages  StagingPage[]

  // การค้นหาใช้ LIKE '%คำค้น%' ซึ่ง btree index ช่วยไม่ได้เลย ต้องใช้ trigram index
  @@index([nameEnNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_name_en_normalized_trgm_idx")
  @@index([nameThNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "students_name_th_normalized_trgm_idx")
  // ใช้จับคู่แบบสลับชื่อ-นามสกุลตอน match Excel — อันนี้เทียบเท่ากันจึงใช้ btree
  @@index([nameEnSortKey], map: "students_name_en_sort_key_idx")
  // ใช้แยกคนชื่อพ้องด้วยโรงเรียน
  @@index([nameEnNormalized, schoolNormalized], map: "students_name_school_idx")
  @@map("students")
}

/// รอบการนำเข้า 1 ครั้ง = ZIP เกียรติบัตร 1 ไฟล์ + Excel รายชื่อ 1 ไฟล์
model Batch {
  id     String      @id @default(uuid()) @db.Uuid
  examId String      @map("exam_id") @db.Uuid
  exam   Exam        @relation(fields: [examId], references: [id], onDelete: Restrict)
  status BatchStatus @default(DRAFT)

  /// ZIP ที่แอดมินอัปโหลด — ข้างในแยกโฟลเดอร์ตามรางวัล (gold/, silver/, ...)
  sourceZipKey   String? @map("source_zip_key")
  sourceExcelKey String? @map("source_excel_key")

  /// ฮ่องกงส่งฉบับจริงแบบไหนในรอบนี้ — มีผลกับคนที่ถือทั้งใบเหรียญและใบ Perfect Score
  multiAwardPolicy MultiAwardPolicy @default(UNDECIDED) @map("multi_award_policy")

  /// เคลียร์ไฟล์ต้นฉบับ (ZIP) ทิ้งไปแล้วเมื่อไหร่
  /// ZIP กินที่มากที่สุด (360 MB ต่อรอบ) และไม่มีอะไรในระบบเรียกใช้หลังจับคู่เสร็จ
  /// เก็บเวลาไว้เพื่อให้แอดมินรู้ว่าไฟล์หายไปเพราะระบบเคลียร์ ไม่ใช่หายไปเอง
  sourcesClearedAt DateTime? @map("sources_cleared_at")

  // สรุปตัวเลข เช่น { pagesTotal, pagesSplit, foreignSkipped, matched, unmatched }
  stats Json @default("{}")

  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobs         Job[]
  stagingPages StagingPage[]
  certificates Certificate[]

  @@index([examId])
  @@index([status])
  @@map("batches")
}

/// 1 หน้าที่ตัดออกมาจาก PDF รวมเล่ม — ยังไม่ผูกกับผู้เข้าสอบจนกว่าจะ match สำเร็จ
model StagingPage {
  id      String @id @default(uuid()) @db.Uuid
  batchId String @map("batch_id") @db.Uuid
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  pageNumber Int    @map("page_number")
  rawText    String @map("raw_text") @db.Text

  extractedName           String? @map("extracted_name")
  extractedNameNormalized String? @map("extracted_name_normalized")
  extractedNameSortKey    String? @map("extracted_name_sort_key")

  /// เลขบนหน้าเกียรติบัตร (Cert No: 900101) — ตรงกับ CANDIDATE NO ใน Excel
  /// เป็นคีย์จับคู่หลัก เพราะแม่นกว่าชื่อเมื่อมีคนชื่อพ้องกัน
  certNo String? @map("cert_no")
  /// ระดับชั้นที่อ่านได้จาก "for outstanding achievement in ..." เช่น PRIMARY 3
  level  String?

  /// รางวัล — มาจากชื่อโฟลเดอร์ใน ZIP ซึ่งเป็นแหล่งความจริงเดียวที่ครบ
  /// (หน้า Perfect Score ไม่มีข้อความรางวัลพิมพ์อยู่เลย)
  award String?
  /// รางวัลตามที่พิมพ์บนหน้า ใช้ cross-check กับโฟลเดอร์ — null ได้เป็นปกติ
  awardOnPage String? @map("award_on_page")
  /// ปี ค.ศ. ที่อ่านได้จากหน้า ใช้ประกอบชื่อไฟล์
  certYear Int? @map("cert_year")
  /// รอบที่อ่านได้จากหน้า (HEAT/FINAL) ใช้ cross-check กับรอบที่แอดมินเลือก
  roundOnPage String? @map("round_on_page")
  /// ไฟล์ไหนใน ZIP — ไว้ไล่ย้อนกลับไปหาต้นทางเมื่อมีปัญหา
  sourceFile String? @map("source_file")

  pdfKey     String? @map("pdf_key")
  previewKey String? @map("preview_key")

  matchStatus     MatchStatus @default(UNMATCHED) @map("match_status")
  matchedStudentId String?    @map("matched_student_id") @db.Uuid
  matchedStudent   Student?   @relation(fields: [matchedStudentId], references: [id], onDelete: SetNull)
  // true เมื่อแอดมินจับคู่เอง ไม่ใช่ระบบจับให้ — ไว้ตรวจย้อนหลัง
  matchedManually Boolean @default(false) @map("matched_manually")
  matchNote       String? @map("match_note")

  /// รางวัลตามที่ Excel เขียน ใช้ cross-check กับรางวัลจากโฟลเดอร์
  /// และให้แอดมินเห็นครบตอนตัดสิน โดยไม่ต้องเปิด Excel มาไล่หาเอง
  rosterAward String? @map("roster_award")

  createdAt DateTime @default(now()) @map("created_at")

  certificate Certificate?

  @@unique([batchId, pageNumber])
  @@index([batchId, matchStatus])
  @@index([extractedNameNormalized])
  // ใช้จับคู่ด้วยเลขเกียรติบัตร ซึ่งแม่นกว่าชื่อเมื่อมีคนชื่อซ้ำ
  @@index([batchId, certNo], map: "staging_pages_batch_id_cert_no_idx")
  @@map("staging_pages")
}

/// เกียรติบัตรที่จับคู่สำเร็จแล้ว — นี่คือสิ่งที่ผู้ใช้ค้นเจอและดาวน์โหลด
model Certificate {
  id        String  @id @default(uuid()) @db.Uuid
  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId    String  @map("exam_id") @db.Uuid
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Restrict)
  batchId   String  @map("batch_id") @db.Uuid
  batch     Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  stagingPageId String      @unique @map("staging_page_id") @db.Uuid
  stagingPage   StagingPage @relation(fields: [stagingPageId], references: [id], onDelete: Cascade)

  pdfKey     String  @map("pdf_key")
  previewKey String? @map("preview_key")
  pageNumber Int     @map("page_number")

  /// รางวัล (GOLD/SILVER/BRONZE/MERIT/PERFECT_SCORE) — บังคับต้องมี
  /// เพราะเป็นส่วนหนึ่งของกติกา unique ด้านล่าง และ Postgres ถือว่า NULL ไม่เท่ากับ NULL
  /// ถ้าปล่อยให้ว่างได้ กติกานั้นจะกันของซ้ำไม่ได้จริง
  award String
  /// เลขบนหน้าเกียรติบัตร = CANDIDATE NO ใน Excel
  certNo      String? @map("cert_no")
  candidateNo String? @map("candidate_no")
  level       String?

  // ผู้ใช้ทั่วไปเห็นเฉพาะ published = true
  published DateTime? @map("published_at")

  /// ครบกำหนดเก็บเมื่อไหร่ — ตั้งตอนเผยแพร่ครั้งแรก = published_at + อายุการเก็บ
  /// เก็บเป็นวันที่จริง ไม่คำนวณสดจาก published_at เพราะถ้าเปลี่ยนนโยบายภายหลัง
  /// ของเก่าต้องไม่ถูกยืดอายุตามไปโดยไม่ตั้งใจ และแอดมินต้องเห็นได้ว่าใบไหนหายวันไหน
  expiresAt DateTime? @map("expires_at")
  /// ลบไฟล์บน R2 ไปแล้วเมื่อไหร่ — แถวยังอยู่เพื่อให้รู้ว่าเคยออกใบอะไรให้ใคร
  filesDeletedAt DateTime? @map("files_deleted_at")

  createdAt DateTime @default(now()) @map("created_at")

  // คนเดียวกันมีได้หลายใบในรอบเดียวกัน ถ้าเป็นคนละรางวัล
  // (ของจริง: ผู้ที่ได้ Perfect Score จะได้ใบ Gold มาด้วยอีกใบ)
  // แต่รางวัลเดียวกันซ้ำสองใบไม่ได้ — นั่นแปลว่าจับคู่ผิดหรือไฟล์ซ้ำ
  @@unique([examId, studentId, award])
  @@index([studentId])
  @@index([batchId])
  /// ตัวกวาดอายุถามด้วยเงื่อนไขนี้ทุกวัน
  @@index([expiresAt, filesDeletedAt])
  @@map("certificates")
}

/// คิวงานของ worker — poll ด้วย SELECT ... FOR UPDATE SKIP LOCKED
model Job {
  id      String  @id @default(uuid()) @db.Uuid
  type    JobType
  /// ว่างได้เฉพาะงานที่ไม่ผูกกับรอบนำเข้าใด (เช่น EXPIRE ที่กวาดทั้งระบบ)
  batchId String? @map("batch_id") @db.Uuid
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  status   JobStatus @default(QUEUED)
  payload  Json      @default("{}")
  progress Json      @default("{}")

  attempts Int     @default(0)
  error    String? @db.Text
  /// true = ล้มเหลวเพราะไฟล์ที่แอดมินอัปเข้ามาไม่ถูก ไม่ใช่ระบบพัง
  /// แยกไว้เพื่อให้หน้าจอไม่ขึ้นกล่องแดง "ประมวลผลล้มเหลว" กับความผิดพลาดของคนใช้งาน
  userError Boolean @default(false) @map("user_error")

  lockedAt   DateTime? @map("locked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([status, createdAt])
  @@index([batchId])
  @@map("jobs")
}
