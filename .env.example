# ---------- Database ----------
# dev: ใช้ค่านี้กับ docker-compose ได้เลย
# prod: Railway จะ inject ค่านี้ให้อัตโนมัติผ่าน service variable
DATABASE_URL=postgresql://ocec:ocec@localhost:5432/ocec?schema=public

# ---------- Object Storage (Cloudflare R2 / MinIO ตอน dev) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=ocec-cert
# dev ชี้ไป MinIO, prod ชี้ไป https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=http://localhost:9000
# โดเมน CDN สำหรับไฟล์ preview (prod = custom domain ที่ผูกกับ R2 bucket)
R2_PUBLIC_BASE_URL=http://localhost:9000/ocec-cert
# ใช้ path-style URL (จำเป็นสำหรับ MinIO, R2 ใช้ได้ทั้งสองแบบ)
R2_FORCE_PATH_STYLE=true

# ---------- Admin auth ----------
# รหัสผ่านเดียวสำหรับล็อกอินหน้า /admin
ADMIN_PASSWORD=change-me-in-production
# ใช้ sign session cookie - สุ่มด้วย: openssl rand -hex 32
SESSION_SECRET=change-me-please-use-a-long-random-string

# ---------- Web <-> Worker ----------
# dev: http://localhost:8000 | prod (Railway private network): http://worker.railway.internal:8000
WORKER_BASE_URL=http://localhost:8000
# shared secret ที่ web ใช้ยิงเข้า worker - สุ่มด้วย: openssl rand -hex 32
WORKER_SHARED_SECRET=change-me-too

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
